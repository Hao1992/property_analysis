# ─── Required ──────────────────────────────────────────────────────────────────
# Google Places API: enable "Places API" in Google Cloud Console.
# Free tier gives $200/month credit (~400 full analyses/month for free).
GOOGLE_PLACES_API_KEY=your_key_here

# ─── AI Narrative ──────────────────────────────────────────────────────────────
# SERVER DEPLOYMENT (Railway): set ANTHROPIC_API_KEY — the claude CLI is not
# available on remote servers.
# ANTHROPIC_API_KEY=sk-ant-...

# LOCAL DEV: leave ANTHROPIC_API_KEY unset and instead set USE_CLAUDE_CLI=true
# to route through `claude -p` subprocess (requires Claude Code subscription).
# USE_CLAUDE_CLI=true

# ─── Infrastructure ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=86400

# ─── Analytics ────────────────────────────────────────────────────────────────
# Optional but recommended in production. Use a Neon/Supabase/Aiven Postgres URL.
# When unset, analytics falls back to ephemeral local files under /tmp.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
ANALYTICS_TOKEN=change_me_for_admin_dashboard

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list. Railway: set to your Vercel URL.
ALLOWED_ORIGINS=http://localhost:5173

# ─── External APIs (all free, all optional) ────────────────────────────────────
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# TMB (Barcelona transit) — optional, used for route enrichment
TMB_APP_ID=your_tmb_app_id
TMB_APP_KEY=your_tmb_app_key

# AEMET (Spanish meteorological agency) — optional, used for flood/climate zones
AEMET_API_KEY=your_aemet_key
